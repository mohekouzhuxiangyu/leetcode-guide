# 复制为 .env 并填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=postgresql://localhost:5432/leetcode_guide
# 邮件发送（SMTP）；留空 SMTP_HOST 则为开发模式：验证链接直接打印到日志并返回给前端
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=leetcode-guide@example.com
# 验证链接使用的应用地址（部署时改成你的域名）
APP_BASE_URL=http://127.0.0.1:8001

# 支付宝（VIP 支付）；留空 ALIPAY_APP_ID 为开发模式：支付走本站 mock 接口直接模拟成功
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# PayJS（个人支付宝当面付扫码，payjs.cn 实名开通后提供）
PAYJS_MCHID=
PAYJS_KEY=
